---
import BaseLayout from "./BaseLayout.astro";

interface Props {
	title: string;
	description: string;
	pubDate: string;
	updatedDate?: string;
	tags?: string[];
}

const { title, description, pubDate, updatedDate, tags = [] } = Astro.props;

const formatDate = (value: string) => {
	const date = new Date(`${value}T00:00:00`);
	return Number.isNaN(date.getTime())
		? value
		: new Intl.DateTimeFormat("es", {
			day: "numeric",
			month: "long",
			year: "numeric",
		}).format(date);
};
---

<BaseLayout
	title={`${title} | Portfolio name TO_REPLACE`}
	description={description}
>
	<article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
		<a
			href="/blog/"
			class="inline-flex min-h-11 items-center text-sm font-semibold text-accent-red underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-red"
		>
			<span aria-hidden="true" class="mr-2">←</span> Volver al blog
		</a>

		<header class="mt-6">
			<p class="font-mono text-sm uppercase tracking-wide text-accent-red">Artículo demostrativo</p>
			<h1 class="mt-3 text-4xl font-bold tracking-tight text-rich-black sm:text-5xl">{title}</h1>
			<p class="mt-5 text-lg leading-8 text-rich-black/75">{description}</p>

			<div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-rich-black/65">
				<p>
					Publicado el <time datetime={pubDate}>{formatDate(pubDate)}</time>
				</p>
				{updatedDate && (
					<p>
						Actualizado el <time datetime={updatedDate}>{formatDate(updatedDate)}</time>
					</p>
				)}
			</div>

			{tags.length > 0 && (
				<ul aria-label="Etiquetas del artículo" class="mt-5 flex flex-wrap gap-2">
					{tags.map((tag) => (
						<li class="rounded-sm border border-rose-quartz/60 bg-white px-3 py-1 font-mono text-xs text-rich-black/75">
							{tag}
						</li>
					))}
				</ul>
			)}
		</header>

		<div class="mt-10 rounded-sm border border-rose-quartz/40 bg-white px-6 py-8 text-rich-black/80 sm:px-10 [&_a]:font-semibold [&_a]:text-accent-red [&_a]:underline [&_a]:underline-offset-4 [&_a:focus-visible]:outline-2 [&_a:focus-visible]:outline-offset-4 [&_a:focus-visible]:outline-accent-red [&_blockquote]:border-l-4 [&_blockquote]:border-selective-yellow [&_blockquote]:bg-seasalt [&_blockquote]:px-5 [&_blockquote]:py-4 [&_h2]:mb-4 [&_h2]:mt-9 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-rich-black [&_h3]:mb-3 [&_h3]:mt-7 [&_h3]:text-xl [&_h3]:font-bold [&_h3]:text-rich-black [&_li]:ml-6 [&_li]:list-disc [&_ol_li]:list-decimal [&_p]:mb-5 [&_p]:leading-8 [&_pre]:overflow-x-auto [&_pre]:rounded-sm [&_pre]:bg-rich-black [&_pre]:p-5 [&_pre]:text-sm [&_pre]:leading-7 [&_pre]:text-seasalt [&_code]:font-mono">
			<slot />
		</div>
	</article>
</BaseLayout>
