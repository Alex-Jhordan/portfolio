---
import BaseLayout from './BaseLayout.astro';
import type { Post } from '../types/wordpress.ts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const date = post.date ? new Date(post.date) : null;
const dateLabel = date && !Number.isNaN(date.getTime())
  ? new Intl.DateTimeFormat('en', { dateStyle: 'long' }).format(date)
  : 'Article';
const description = post.excerpt?.replace(/<[^>]*>/g, '').trim() || `Read ${post.title} by Alex Jordan.`;
---

<BaseLayout title={`${post.title} | Alex Jordan`} description={description} image={post.featuredImage?.node.sourceUrl}>
  <main>
    <section class="border-b border-rose-quartz/30 bg-rich-black text-seasalt">
      <div class="mx-auto max-w-6xl px-6 py-16 sm:py-24">
        <a class="font-mono text-[10px] uppercase tracking-[0.22em] text-selective-yellow no-underline hover:text-seasalt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-selective-yellow" href="/blog/">
          <span aria-hidden="true">←</span> Back to blog
        </a>
        <div class="mt-10 max-w-4xl">
          <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-rose-quartz">Technical journal</p>
          <h1 class="mt-3 text-4xl font-semibold leading-tight sm:text-6xl">{post.title}</h1>
          <time class="mt-6 block font-mono text-xs uppercase tracking-[0.16em] text-seasalt/60" datetime={post.date}>{dateLabel}</time>
        </div>
      </div>
    </section>

    <section class="bg-seasalt">
      <div class="mx-auto max-w-3xl px-6 py-16 sm:py-24">
        {post.featuredImage?.node && (
          <img
            class="mb-12 aspect-video w-full border border-rose-quartz/50 object-cover"
            src={post.featuredImage.node.sourceUrl}
            alt={post.featuredImage.node.altText || `${post.title} featured image`}
            width={post.featuredImage.node.mediaDetails?.width}
            height={post.featuredImage.node.mediaDetails?.height}
          />
        )}

        <article class="post-content text-base leading-8 text-rich-black/80" set:html={post.content} />
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .post-content :global(h2),
  .post-content :global(h3) {
    margin-top: 2.75rem;
    margin-bottom: 1rem;
    color: var(--color-rich-black);
    font-weight: 600;
    line-height: 1.25;
  }

  .post-content :global(h2) {
    font-size: 1.75rem;
  }

  .post-content :global(h3) {
    font-size: 1.25rem;
  }

  .post-content :global(p) {
    margin-top: 1rem;
  }

  .post-content :global(a) {
    color: var(--color-accent-red);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-top: 1rem;
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    margin-top: 0.5rem;
  }

  .post-content :global(blockquote) {
    margin-top: 2rem;
    border-left: 2px solid var(--color-selective-yellow);
    padding-left: 1rem;
    color: color-mix(in srgb, var(--color-rich-black) 70%, transparent);
    font-style: italic;
  }

  .post-content :global(pre) {
    overflow-x: auto;
    margin-top: 2rem;
    padding: 1.25rem;
    background: var(--color-rich-black);
    color: var(--color-seasalt);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .post-content :global(img) {
    max-width: 100%;
    height: auto;
  }
</style>