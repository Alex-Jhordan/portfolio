---
interface Props {
  year?: number;
}

const { year = new Date().getFullYear() } = Astro.props;

const socialLinks = [
  {
    label: 'GitHub',
    href: 'https://github.com/Alex-Jhordan',
    ariaLabel: 'Visit Alex Jhordan on GitHub'
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/alex-jhordan',
    ariaLabel: 'Visit Alex Jhordan on LinkedIn'
  }
];
---

<footer class="border-t border-rose-quartz/30 bg-rich-black text-seasalt">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-8 md:flex-row md:items-center md:justify-between">
    <div class="space-y-3">
      <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-rose-quartz">
        Available for work
      </p>
      <p class="text-sm text-seasalt/80">
        © {year} Alex Jhordan. Built with Astro and WordPress.
      </p>
    </div>

    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6">
      <div class="flex items-center gap-3">
        <span class="inline-flex size-2.5 rounded-full bg-emerald-500 shadow-[0_0_0_4px_rgba(16,185,129,0.12)]" aria-hidden="true"></span>
        <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-seasalt/70">
          Open to opportunities
        </span>
      </div>

      <div class="flex items-center gap-4 text-sm text-seasalt/80">
        {socialLinks.map((link) => (
          <a
            class="font-mono text-[10px] uppercase tracking-[0.18em] text-seasalt/80 no-underline transition-colors duration-150 hover:text-selective-yellow focus-visible:text-selective-yellow"
            href={link.href}
            target="_blank"
            rel="noreferrer"
            aria-label={link.ariaLabel}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
