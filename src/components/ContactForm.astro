---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Contacto",
	description = "Completa los campos para enviar un mensaje al propietario del portfolio.",
} = Astro.props;

const endpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT?.trim() || "";
const isConfigured = endpoint.length > 0 && !endpoint.includes("TO_REPLACE");
---

<section aria-labelledby="contacto-titulo" class="mx-auto max-w-2xl">
	<h2 id="contacto-titulo" class="text-3xl font-bold text-rich-black">{title}</h2>
	<p class="mt-3 leading-7 text-rich-black/75">{description}</p>

	<div
		class:list={[
			"mt-6 rounded-sm border px-4 py-3 text-sm",
			isConfigured
				? "hidden"
				: "border-selective-yellow bg-selective-yellow/20 text-rich-black",
		]}
		role="alert"
		data-configuration-status
	>
		Formulario de demostración: configura <code>PUBLIC_FORMSPREE_ENDPOINT</code> antes de habilitar los envíos. La configuración actual es un marcador <code>TO_REPLACE</code>.
	</div>

	<form
		action={isConfigured ? endpoint : "#"}
		method="POST"
		class="mt-6 space-y-5"
		data-contact-form
		data-endpoint={endpoint}
	>
		<div>
			<label for="contact-name" class="mb-2 block font-semibold text-rich-black">Nombre</label>
			<input
				id="contact-name"
				name="name"
				type="text"
				autocomplete="name"
				required
				class="min-h-12 w-full rounded-sm border border-rose-quartz bg-white px-4 py-3 text-rich-black shadow-sm focus:border-accent-red focus:outline-none focus:ring-2 focus:ring-accent-red/30"
			/>
		</div>

		<div>
			<label for="contact-email" class="mb-2 block font-semibold text-rich-black">Correo electrónico</label>
			<input
				id="contact-email"
				name="email"
				type="email"
				autocomplete="email"
				required
				class="min-h-12 w-full rounded-sm border border-rose-quartz bg-white px-4 py-3 text-rich-black shadow-sm focus:border-accent-red focus:outline-none focus:ring-2 focus:ring-accent-red/30"
			/>
		</div>

		<div>
			<label for="contact-message" class="mb-2 block font-semibold text-rich-black">Mensaje</label>
			<textarea
				id="contact-message"
				name="message"
				rows="7"
				required
				class="w-full resize-y rounded-sm border border-rose-quartz bg-white px-4 py-3 text-rich-black shadow-sm focus:border-accent-red focus:outline-none focus:ring-2 focus:ring-accent-red/30"
			></textarea>
		</div>

		<button
			type="submit"
			disabled={!isConfigured}
			class="inline-flex min-h-12 w-full items-center justify-center rounded-sm bg-accent-red px-5 py-3 font-semibold text-white hover:bg-red-700 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-red disabled:cursor-not-allowed disabled:bg-rose-quartz sm:w-auto"
			data-submit-button
		>
			Enviar mensaje
		</button>

		<p
			role="status"
			aria-live="polite"
			aria-atomic="true"
			class="min-h-6 text-sm font-medium text-rich-black"
			data-form-status
		></p>
	</form>
</section>

<script>
	const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
	const status = document.querySelector<HTMLElement>("[data-form-status]");
	const submitButton = document.querySelector<HTMLButtonElement>("[data-submit-button]");

	if (form && status && submitButton) {
		let isSubmitting = false;
		const defaultButtonText = submitButton.textContent || "Enviar mensaje";

		form.addEventListener("submit", async (event) => {
			event.preventDefault();

			const endpoint = form.dataset.endpoint?.trim() || "";
			if (!endpoint || endpoint.includes("TO_REPLACE")) {
				status.textContent = "El formulario no está configurado y no puede enviar mensajes todavía.";
				return;
			}

			if (isSubmitting) return;
			isSubmitting = true;
			submitButton.disabled = true;
			submitButton.setAttribute("aria-disabled", "true");
			submitButton.textContent = "Enviando…";
			status.textContent = "Enviando tu mensaje…";

			try {
				const response = await fetch(endpoint, {
					method: "POST",
					body: new FormData(form),
					headers: { Accept: "application/json" },
				});

				if (!response.ok) {
					throw new Error(`El servicio respondió con estado ${response.status}.`);
				}

				form.reset();
				status.textContent = "Mensaje enviado correctamente. Gracias por escribir.";
			} catch {
				status.textContent = "No fue posible enviar el mensaje. Inténtalo de nuevo en unos minutos.";
			} finally {
				isSubmitting = false;
				submitButton.disabled = false;
				submitButton.removeAttribute("aria-disabled");
				submitButton.textContent = defaultButtonText;
			}
		});
	}
</script>
