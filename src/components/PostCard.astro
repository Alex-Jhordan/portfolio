---
import type { Post } from '../types/wordpress.ts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const postUrl = `/blog/${post.slug}/`;
const date = post.date ? new Date(post.date) : null;
const dateLabel = date && !Number.isNaN(date.getTime())
  ? new Intl.DateTimeFormat('en', { dateStyle: 'medium' }).format(date)
  : 'Article';
const wordCount = post.content.replace(/<[^>]*>/g, ' ').trim().split(/\s+/).filter(Boolean).length;
const readTime = Math.max(1, Math.ceil(wordCount / 200));
const summary = post.excerpt?.replace(/<[^>]*>/g, '').trim();
---

<article class="group flex h-full flex-col border-t-2 border-rich-black pt-5 text-rich-black transition-colors duration-200 hover:border-accent-red">
  <div class="flex items-center justify-between gap-4 font-mono text-[10px] uppercase tracking-[0.16em] text-rose-quartz">
    <time datetime={post.date}>{dateLabel}</time>
    <span>{readTime} min read</span>
  </div>

  <h3 class="mt-5 text-2xl font-semibold leading-tight">
    <a class="no-underline transition-colors duration-150 group-hover:text-accent-red focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-red" href={postUrl}>{post.title}</a>
  </h3>

  {summary && <p class="mt-4 line-clamp-3 text-sm leading-7 text-rich-black/70">{summary}</p>}

  <a class="mt-auto inline-flex items-center gap-3 pt-7 font-mono text-xs uppercase tracking-[0.14em] text-accent-red no-underline hover:text-rich-black focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-red" href={postUrl}>
    Read article <span aria-hidden="true">→</span>
  </a>
</article>