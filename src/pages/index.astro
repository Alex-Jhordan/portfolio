---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ExperienceItem from "../components/ExperienceItem.astro";
import ArticleCard from "../components/ArticleCard.astro";

const projects = (await getCollection("projects"))
	.filter((entry) => entry.data.featured)
	.sort((left, right) => left.data.order - right.data.order);

const experience = (await getCollection("experience"))
	.sort((left, right) => left.data.order - right.data.order);

const articles = (await getCollection("articles"))
	.filter((entry) => !entry.data.draft)
	.sort((left, right) => right.data.pubDate.localeCompare(left.data.pubDate))
	.slice(0, 3);
---

<BaseLayout
	title="Inicio | Alex Jhordan"
	description="Portafolio de Alex Jhordan, full stack software engineer especializado en Laravel, APIs, WordPress e integración con inteligencia artificial."
>
	<Hero
		title="Del problema al producto"
		eyebrow="Full Stack Software Engineer"
		introduction="Resuelvo problemas de negocio construyendo aplicaciones. Te acompaño desde entender qué frena tu operación hasta entregar una solución clara, mantenible y pensada para simplificarte el trabajo."
		primaryHref="/projects/"
		secondaryLabel="Contactar"
		secondaryHref="/contact/"
	/> 

	<section aria-labelledby="proyectos-destacados" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
		<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<p class="font-mono text-sm uppercase tracking-wide text-accent-red">Selección destacada</p>
				<h2 id="proyectos-destacados" class="mt-2 text-3xl font-bold tracking-tight text-rich-black">Proyectos destacados</h2>
				<p class="mt-3 max-w-2xl leading-7 text-rich-black/75">
					Aplicaciones y soluciones desarrolladas con diferentes tecnologías, enfoques técnicos y objetivos.
				</p>
			</div>
			<a
				href="/projects/"
				class="inline-flex min-h-11 items-center font-semibold text-accent-red underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-red"
			>
				Ver todos los proyectos <span aria-hidden="true" class="ml-2">→</span>
			</a>
		</div>

		{projects.length > 0 ? (
			<div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
				{projects.map((entry) => (
					<ProjectCard
						title={entry.data.title}
						summary={entry.data.summary}
						slug={entry.data.slug}
						technologies={entry.data.technologies}
						cover={entry.data.cover}
						coverAlt={entry.data.coverAlt}
					/>
				))}
			</div>
		) : (
			<div class="mt-8 rounded-sm border border-dashed border-rose-quartz bg-white p-6">
				<p class="font-semibold text-rich-black">Aún no hay proyectos públicos destacados.</p>
			</div>
		)}
	</section>

	<section aria-labelledby="experiencia-profesional" class="border-y border-rose-quartz/40 bg-white">
		<div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
			<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
				<div>
					<p class="font-mono text-sm uppercase tracking-wide text-accent-red">Trayectoria profesional</p>
					<h2 id="experiencia-profesional" class="mt-2 text-3xl font-bold tracking-tight text-rich-black">Experiencia profesional</h2>
					<p class="mt-3 max-w-2xl leading-7 text-rich-black/75">
						Roles, responsabilidades y resultados destacados de mi trayectoria en desarrollo de software.
					</p>
				</div>
				<a
					href="/about/"
					class="inline-flex min-h-11 items-center font-semibold text-accent-red underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-red"
				>
					Conocer más <span aria-hidden="true" class="ml-2">→</span>
				</a>
			</div>

			{experience.length > 0 ? (
				<div class="mt-8 max-w-3xl">
					{experience.map((entry) => (
						<ExperienceItem
							role={entry.data.role}
							organization={entry.data.organization}
							startDate={entry.data.startDate}
							endDate={entry.data.endDate}
							current={entry.data.current}
							description={entry.data.description}
						/>
					))}
				</div>
			) : (
				<div class="mt-8 rounded-sm border border-dashed border-rose-quartz bg-seasalt p-6">
					<p class="font-semibold text-rich-black">Aún no hay experiencia pública disponible.</p>
				</div>
			)}
		</div>
	</section>

	<section aria-labelledby="articulos-recientes" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
		<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<p class="font-mono text-sm uppercase tracking-wide text-accent-red">Notas técnicas</p>
				<h2 id="articulos-recientes" class="mt-2 text-3xl font-bold tracking-tight text-rich-black">Artículos recientes</h2>
				<p class="mt-3 max-w-2xl leading-7 text-rich-black/75">
					Ideas y notas sobre desarrollo, tecnología, proyectos y aprendizajes técnicos.
				</p>
			</div>
			<a
				href="/blog/"
				class="inline-flex min-h-11 items-center font-semibold text-accent-red underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-red"
			>
				Ver todos los artículos <span aria-hidden="true" class="ml-2">→</span>
			</a>
		</div>

		{articles.length > 0 ? (
			<div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
				{articles.map((entry) => (
					<ArticleCard
						title={entry.data.title}
						description={entry.data.description}
						slug={entry.data.slug}
						pubDate={entry.data.pubDate}
					/>
				))}
			</div>
		) : (
			<div class="mt-8 rounded-sm border border-dashed border-rose-quartz bg-white p-6">
				<p class="font-semibold text-rich-black">Aún no hay artículos publicados.</p>
			</div>
		)}
	</section>
</BaseLayout>
