---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ExperienceItem from "../components/ExperienceItem.astro";
import PostCard from "../components/PostCard.astro";
import { fetchExperiences, fetchPosts, fetchProjects } from "../lib/graphql.ts";

const [{ edges: projectEdges }, { edges: experienceEdges }, { edges: postEdges }] = await Promise.all([
	fetchProjects(),
	fetchExperiences(),
	fetchPosts()
]);

const featuredProjects = projectEdges
	.map(({ node }) => node)
	.filter((project) => project.projectDetails?.isFeatured)
	.sort((first, second) => (first.projectDetails?.displayOrder ?? 0) - (second.projectDetails?.displayOrder ?? 0));
const experiences = experienceEdges.map(({ node }) => node);
const recentPosts = postEdges
	.map(({ node }) => node)
	.sort((first, second) => new Date(second.date ?? 0).getTime() - new Date(first.date ?? 0).getTime())
	.slice(0, 3);
---

<BaseLayout title="Alex Jordan | Developer Portfolio" description="The portfolio and technical blog of Alex Jordan.">
	<main>
		<Hero
			eyebrow="Alex Jhordan / Full-stack developer"
			title="I build clear, resilient digital products."
			description="I turn complex requirements into thoughtful interfaces and dependable systems, with a focus on performance, accessibility, and useful details."
			technologies={['Astro', 'TypeScript', 'WordPress', 'Tailwind CSS']}
			links={[
				{ label: 'View projects', href: '/projects/' },
				{ label: 'Get in touch', href: '/contact/' }
			]}
		/>

		<section class="border-b border-rose-quartz/30 bg-seasalt" aria-labelledby="featured-projects-title">
			<div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
				<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
					<div>
						<p class="font-mono text-[10px] uppercase tracking-[0.22em] text-accent-red">Selected work</p>
						<h2 id="featured-projects-title" class="mt-3 text-4xl font-semibold leading-tight">Featured projects</h2>
					</div>
					<a class="font-mono text-xs uppercase tracking-[0.14em] text-rich-black/70 no-underline hover:text-accent-red focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-red" href="/projects/">View all projects <span aria-hidden="true">↗</span></a>
				</div>

				{featuredProjects.length > 0 ? (
					<div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
						{featuredProjects.map((project) => <ProjectCard project={project} />)}
					</div>
				) : (
					<p class="mt-10 border-l-2 border-selective-yellow py-2 pl-4 text-sm leading-7 text-rich-black/70">Featured projects will appear here soon.</p>
				)}
			</div>
		</section>

		<section class="border-b border-rose-quartz/30 bg-seasalt" aria-labelledby="experience-title">
			<div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
				<div class="max-w-2xl">
					<p class="font-mono text-[10px] uppercase tracking-[0.22em] text-accent-red">Experience</p>
					<h2 id="experience-title" class="mt-3 text-4xl font-semibold leading-tight">A timeline of useful work.</h2>
				</div>

				{experiences.length > 0 ? (
					<div class="mt-10 max-w-4xl">
						{experiences.map((experience, index) => <ExperienceItem experience={experience} current={index === 0} />)}
					</div>
				) : (
					<p class="mt-10 border-l-2 border-selective-yellow py-2 pl-4 text-sm leading-7 text-rich-black/70">Experience details will appear here soon.</p>
				)}
			</div>
		</section>

		<section class="bg-seasalt" aria-labelledby="recent-posts-title">
			<div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
				<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
					<div>
						<p class="font-mono text-[10px] uppercase tracking-[0.22em] text-accent-red">From the journal</p>
						<h2 id="recent-posts-title" class="mt-3 text-4xl font-semibold leading-tight">Recent writing</h2>
					</div>
					<a class="font-mono text-xs uppercase tracking-[0.14em] text-rich-black/70 no-underline hover:text-accent-red focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-red" href="/blog/">Read the blog <span aria-hidden="true">↗</span></a>
				</div>

				{recentPosts.length > 0 ? (
					<div class="mt-10 grid gap-10 md:grid-cols-2 lg:grid-cols-3">
						{recentPosts.map((post) => <PostCard post={post} />)}
					</div>
				) : (
					<p class="mt-10 border-l-2 border-selective-yellow py-2 pl-4 text-sm leading-7 text-rich-black/70">New articles will appear here soon.</p>
				)}
			</div>
		</section>
	</main>
</BaseLayout>
