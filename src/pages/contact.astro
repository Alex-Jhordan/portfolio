---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";

const profileLinks = [
	{
		name: "GitHub",
		href: "https://github.com/TO_REPLACE",
	},
	{
		name: "LinkedIn",
		href: "https://linkedin.com/in/TO_REPLACE",
	},
];
---

<BaseLayout
	title="Contacto | Portfolio name TO_REPLACE"
	description="Formulario de contacto de demostración y enlaces ficticios a perfiles profesionales de Portfolio name TO_REPLACE."
>
	<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20" aria-labelledby="titulo-contacto">
		<header class="max-w-3xl">
			<p class="font-mono text-sm uppercase tracking-wide text-accent-red">Página de demostración</p>
			<h1 id="titulo-contacto" class="mt-3 text-4xl font-bold tracking-tight text-rich-black sm:text-5xl">
				Contacto
			</h1>
			<p class="mt-5 text-lg leading-8 text-rich-black/80">
				Usa este formulario de ejemplo para comprobar la interfaz y los estados de envío. Sustituye la configuración y los perfiles ficticios antes de publicar.
			</p>
		</header>

		<div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(18rem,1fr)] lg:items-start">
			<div class="rounded-sm border border-rose-quartz/40 bg-white p-6 sm:p-8">
				<ContactForm />
			</div>

			<aside aria-labelledby="perfiles-profesionales" class="rounded-sm bg-rich-black p-6 text-seasalt sm:p-8">
				<h2 id="perfiles-profesionales" class="text-2xl font-bold">Perfiles profesionales</h2>
				<p class="mt-3 leading-7 text-seasalt/75">
					Enlaces de ejemplo que contienen marcadores <code>TO_REPLACE</code>.
				</p>

				<nav aria-label="Perfiles profesionales de demostración" class="mt-5">
					<ul class="space-y-2">
						{profileLinks.map((profile) => (
							<li>
								<a
									href={profile.href}
									rel="noopener noreferrer"
									target="_blank"
									class="inline-flex min-h-11 items-center underline-offset-4 hover:text-selective-yellow hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-selective-yellow"
								>
									{profile.name} TO_REPLACE <span aria-hidden="true" class="ml-2">↗</span>
								</a>
								<!-- TODO: Replace this sample GitHub or LinkedIn URL containing TO_REPLACE with the owner's real professional profile URL. -->
							</li>
						))}
					</ul>
				</nav>
			</aside>
		</div>
	</section>
</BaseLayout>
