---
import BaseLayout from "../layouts/BaseLayout.astro";
import TechBadge from "../components/TechBadge.astro";

const skillGroups = [
	{
		label: "Build",
		skills: ["TypeScript", "Astro", "JavaScript", "HTML & CSS"]
	},
	{
		label: "Connect",
		skills: ["WordPress", "WPGraphQL", "REST APIs", "SQL"]
	},
	{
		label: "Ship",
		skills: ["Git", "Testing", "Accessibility", "Performance"]
	}
];

const focusAreas = [
	{
		number: "01",
		title: "Useful interfaces",
		description: "I design and build interfaces that make the next action obvious, keep important information findable, and remain comfortable to use across screen sizes."
	},
	{
		number: "02",
		title: "Durable systems",
		description: "I care about the quiet engineering work behind a good product: clear data boundaries, predictable APIs, sensible content models, and code that can be changed later."
	},
	{
		number: "03",
		title: "Fast by default",
		description: "Performance and accessibility belong in the first implementation. I use static delivery, semantic markup, and progressive enhancement to keep products quick and dependable."
	}
];
---

<BaseLayout title="About Alex Jhordan | Developer Portfolio" description="Learn about Alex Jhordan's software development background, current focus, and technical skills.">
	<main>
		<section class="border-b border-rich-black/20 bg-rich-black text-seasalt" aria-labelledby="about-title">
			<div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
				<div class="max-w-3xl">
					<p class="font-mono text-[10px] uppercase tracking-[0.22em] text-selective-yellow">About / 01</p>
					<h1 id="about-title" class="mt-5 text-5xl font-semibold leading-[1.05] tracking-tight sm:text-7xl">I like making complex things feel clear.</h1>
					<p class="mt-8 max-w-2xl text-lg leading-8 text-seasalt/75">I’m Alex Jhordan, a full-stack developer focused on thoughtful interfaces, resilient systems, and the useful details that help digital products earn trust.</p>
				</div>
			</div>
		</section>

		<section class="border-b border-rose-quartz/30 bg-seasalt" aria-labelledby="background-title">
			<div class="mx-auto grid max-w-6xl gap-12 px-6 py-16 sm:py-20 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
				<div>
					<p class="font-mono text-[10px] uppercase tracking-[0.22em] text-accent-red">Background</p>
					<h2 id="background-title" class="mt-3 max-w-sm text-4xl font-semibold leading-tight">Engineering with a human point of view.</h2>
				</div>

				<div class="max-w-2xl space-y-6 text-base leading-8 text-rich-black/75">
					<p>My work sits between product thinking and implementation. I enjoy taking an ambiguous brief, finding the real problem inside it, and shaping a solution that is straightforward for people to use and straightforward for a team to maintain.</p>
					<p>These days, I’m especially interested in content-rich websites and applications where performance, accessibility, and editorial flexibility matter from the first line of code. I work comfortably across the interface and the data layer, bringing the two closer together when it makes the experience better.</p>
					<p>Outside of a feature list, I value direct communication, small feedback loops, and leaving systems in a better state than I found them.</p>
				</div>
			</div>
		</section>

		<section class="border-b border-rose-quartz/30 bg-seasalt" aria-labelledby="focus-title">
			<div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
				<div class="max-w-2xl">
					<p class="font-mono text-[10px] uppercase tracking-[0.22em] text-accent-red">Current focus</p>
					<h2 id="focus-title" class="mt-3 text-4xl font-semibold leading-tight">What I’m working toward.</h2>
				</div>

				<div class="mt-10 grid gap-px border border-rose-quartz/40 bg-rose-quartz/40 md:grid-cols-3">
					{focusAreas.map((area) => (
						<article class="bg-seasalt p-6 sm:p-8">
							<p class="font-mono text-xs text-accent-red">{area.number}</p>
							<h3 class="mt-12 text-2xl font-semibold">{area.title}</h3>
							<p class="mt-4 text-sm leading-7 text-rich-black/70">{area.description}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="border-b border-rose-quartz/30 bg-seasalt" aria-labelledby="skills-title">
			<div class="mx-auto grid max-w-6xl gap-10 px-6 py-16 sm:py-20 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
				<div>
					<p class="font-mono text-[10px] uppercase tracking-[0.22em] text-accent-red">Toolkit</p>
					<h2 id="skills-title" class="mt-3 text-4xl font-semibold leading-tight">Tools I reach for often.</h2>
				</div>

				<div class="grid gap-8 sm:grid-cols-3">
					{skillGroups.map((group) => (
						<div>
							<h3 class="font-mono text-xs uppercase tracking-[0.16em] text-rich-black/60">{group.label}</h3>
							<div class="mt-4 flex flex-wrap gap-2">
								{group.skills.map((skill) => <TechBadge name={skill} />)}
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="bg-selective-yellow" aria-labelledby="about-cta-title">
			<div class="mx-auto flex max-w-6xl flex-col gap-8 px-6 py-14 sm:flex-row sm:items-center sm:justify-between sm:py-16">
				<div>
					<p class="font-mono text-[10px] uppercase tracking-[0.22em] text-rich-black/70">Next step</p>
					<h2 id="about-cta-title" class="mt-3 text-3xl font-semibold leading-tight sm:text-4xl">Let’s make something useful.</h2>
				</div>
				<div class="flex flex-wrap gap-3">
					<a class="inline-flex min-h-12 items-center gap-3 border border-rich-black bg-rich-black px-5 font-mono text-xs uppercase tracking-[0.14em] text-seasalt no-underline transition-colors duration-150 hover:bg-seasalt hover:text-rich-black focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rich-black" href="/alex-jhordan-cv.pdf" download>Download CV <span aria-hidden="true">↓</span></a>
					<a class="inline-flex min-h-12 items-center gap-3 border border-rich-black px-5 font-mono text-xs uppercase tracking-[0.14em] text-rich-black no-underline transition-colors duration-150 hover:bg-rich-black hover:text-seasalt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rich-black" href="/contact/">Get in touch <span aria-hidden="true">↗</span></a>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>