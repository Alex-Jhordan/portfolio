---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { fetchPosts } from '../../lib/graphql.ts';

const { edges: postEdges } = await fetchPosts();
const posts = postEdges
  .map(({ node }) => node)
  .sort((first, second) => new Date(second.date ?? 0).getTime() - new Date(first.date ?? 0).getTime());
---

<BaseLayout title="Blog | Alex Jordan" description="Technical writing on software development, interfaces, and dependable systems by Alex Jordan.">
  <main>
    <section class="border-b border-rose-quartz/30 bg-seasalt">
      <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
        <div class="max-w-2xl">
          <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-accent-red">From the journal</p>
          <h1 class="mt-3 text-4xl font-semibold leading-tight sm:text-5xl">Notes on making things work.</h1>
          <p class="mt-4 text-lg leading-8 text-rich-black/70">Technical articles about building resilient products, useful interfaces, and maintainable systems.</p>
        </div>
      </div>
    </section>

    <section class="bg-seasalt" aria-labelledby="all-posts-title">
      <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
        <h2 id="all-posts-title" class="sr-only">All articles</h2>
        {posts.length > 0 ? (
          <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => <PostCard post={post} />)}
          </div>
        ) : (
          <p class="border-l-2 border-selective-yellow py-2 pl-4 text-sm leading-7 text-rich-black/70">New articles will appear here soon.</p>
        )}
      </div>
    </section>
  </main>
</BaseLayout>